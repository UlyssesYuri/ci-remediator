# Real RDS Postgres.
# Local docker Postgres: postgresql://ci:ci@127.0.0.1:5432/ci_remediator
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.region.rds.amazonaws.com:5432/ci_remediator

AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/ci-remediator

# Only set these for the local elasticmq queue. Leave unset for real AWS,
# where boto3 reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the
# environment on its own.
# SQS_ENDPOINT_URL=http://127.0.0.1:9324
# SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/ci-remediator
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Worker only. The API does not read these.
AWS_S3_BUCKET=ci-remediator-logs
GITHUB_TOKEN=github_pat_placeholder
ANTHROPIC_API_KEY=sk-ant-placeholder
